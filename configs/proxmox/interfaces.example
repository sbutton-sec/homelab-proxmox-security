# /etc/network/interfaces  (SANITISED EXAMPLE – replace NIC names and IPs with your own)

auto lo
iface lo inet loopback

iface enp1s0 inet manual
iface enp2s0 inet manual

# LAN bridge – Proxmox management lives here
auto vmbr0
iface vmbr0 inet static
    address 10.66.66.10/24
    gateway 10.66.66.1
    bridge-ports enp2s0
    bridge-stp off
    bridge-fd 0

# WAN bridge – NO IP on the host; only the OPNsense VM attaches here
auto vmbr1
iface vmbr1 inet manual
    bridge-ports enp1s0
    bridge-stp off
    bridge-fd 0
